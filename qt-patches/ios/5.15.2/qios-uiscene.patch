+
 @implementation QIOSApplicationDelegate
 
+- (UISceneConfiguration *)application:(UIApplication *)application
+                          configurationForConnectingSceneSession:(UISceneSession *)connectingSceneSession
+                          options:(UISceneConnectionOptions *)options
+{
+    Q_UNUSED(application);
+    qCDebug(lcQpaWindowScene) << "Configuring scene for" << connectingSceneSession
+        << "with options" << options;
+
+    UISceneConfiguration *sceneConfig = connectingSceneSession.configuration;
+    sceneConfig.delegateClass = QIOSWindowSceneDelegate.class;
+    return sceneConfig;
+}
+
+@end
+
+@implementation QIOSWindowSceneDelegate
+
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session
+       options:(UISceneConnectionOptions *)connectionOptions
+{
+    Q_UNUSED(session);
+    qCDebug(lcQpaWindowScene) << "Connecting" << scene << "to" << session;
+
+    if (![scene isKindOfClass:[UIWindowScene class]])
+        return;
+
+    UIWindowScene *windowScene = static_cast<UIWindowScene *>(scene);
+    self.window = [[[QUIWindow alloc] initWithWindowScene:windowScene] autorelease];
+    [self configureWindowForScene:windowScene];
+
+    if (connectionOptions.URLContexts.count > 0)
+        [self scene:scene openURLContexts:connectionOptions.URLContexts];
+}
+
+- (void)configureWindowForScene:(UIWindowScene *)windowScene
+{
+    if (!qGuiApp)
+        return;
+
+
+    QIOSScreen *screen = nullptr;
+    for (QScreen *qScreen : qGuiApp->screens()) {
+        QIOSScreen *platformScreen = static_cast<QIOSScreen *>(qScreen->handle());
+        if (platformScreen->uiScreen() == windowScene.screen) {
+            screen = platformScreen;
+            break;
+        }
+    }
+
+    if (!screen) {
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 50 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+            [self configureWindowForScene:windowScene];
+        });
+        return;
+    }
+
+    self.window.rootViewController = [[[QIOSViewController alloc]
+        initWithWindow:self.window andScreen:screen] autorelease];
+    [self.window makeKeyAndVisible];
+}
+
+- (void)scene:(UIScene *)scene openURLContexts:(NSSet<UIOpenURLContext *> *)URLContexts
+{
+    Q_UNUSED(scene);
+    QIOSIntegration *iosIntegration = QIOSIntegration::instance();
+    if (!iosIntegration)
+        return;
+
+    QIOSServices *iosServices = static_cast<QIOSServices *>(iosIntegration->services());
+    for (UIOpenURLContext *urlContext in URLContexts)
+        iosServices->handleUrl(QUrl::fromNSURL(urlContext.URL));
+}
+
+@end
+
