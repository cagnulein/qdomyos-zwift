+UIView *rootViewForScreen(const QPlatformScreen *screen)
+{
+    Q_ASSERT(screen);
+
+    const auto *iosScreen = static_cast<const QIOSScreen *>(screen);
+    UIView *fallbackRootView = nil;
+    for (UIScene *scene in [qt_apple_sharedApplication().connectedScenes allObjects]) {
+        if (![scene isKindOfClass:UIWindowScene.class])
+            continue;
+
+        UIWindowScene *windowScene = static_cast<UIWindowScene *>(scene);
+        // iOS 27 can expose a different UIScreen instance to Qt; keep looking
+        // for the scene-owned Qt window and use it as a fallback below.
+
+        UIWindow *uiWindow = nil;
+        id sceneDelegate = windowScene.delegate;
+        if ([sceneDelegate respondsToSelector:@selector(window)]) {
+            UIWindow *delegateWindow = [sceneDelegate window];
+            if ([delegateWindow isKindOfClass:[QUIWindow class]])
+                uiWindow = delegateWindow;
+        }
+        if (!uiWindow && [windowScene.keyWindow isKindOfClass:[QUIWindow class]])
+            uiWindow = windowScene.keyWindow;
+        if (!uiWindow) {
+            for (UIWindow *window in windowScene.windows) {
+                if ([window isKindOfClass:[QUIWindow class]]) {
+                    uiWindow = window;
+                    break;
+                }
+            }
+        }
+        if (!uiWindow)
+            continue;
+        UIView *rootView = uiWindow.rootViewController.view;
+        if (windowScene.screen == iosScreen->uiScreen())
+            return rootView;
+        if (!fallbackRootView)
+            fallbackRootView = rootView;
+
+    }
+
+    return fallbackRootView;
+}
+
 QT_END_NAMESPACE
 
