+UIView *rootViewForScreen(const QPlatformScreen *screen)
+{
+    Q_ASSERT(screen);
+
+    const auto *iosScreen = static_cast<const QIOSScreen *>(screen);
+    for (UIScene *scene in [qt_apple_sharedApplication().connectedScenes allObjects]) {
+        if (![scene isKindOfClass:UIWindowScene.class])
+            continue;
+
+        UIWindowScene *windowScene = static_cast<UIWindowScene *>(scene);
+        if (windowScene.screen != iosScreen->uiScreen())
+            continue;
+
+        UIWindow *uiWindow = nil;
+        if ([windowScene.keyWindow isKindOfClass:[QUIWindow class]])
+            uiWindow = windowScene.keyWindow;
+        if (!uiWindow) {
+            for (UIWindow *window in windowScene.windows) {
+                if ([window isKindOfClass:[QUIWindow class]]) {
+                    uiWindow = window;
+                    break;
+                }
+            }
+        }
+
+        return uiWindow ? uiWindow.rootViewController.view : nil;
+    }
+
+    return nullptr;
+}
+
 QT_END_NAMESPACE
 
