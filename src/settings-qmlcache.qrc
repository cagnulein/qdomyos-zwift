<!-- Not a resource: the list of the pages that qdomyos-zwift.pri compiles at build time
     (qmlcachegen). The pages themselves stay in qml.qrc, at the same paths. -->
<RCC>
    <qresource prefix="/">
        <file>settings.qml</file>
        <file>settings-tiles.qml</file>
    </qresource>
</RCC>
